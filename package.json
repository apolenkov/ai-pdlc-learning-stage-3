{
  "name": "sdd-guide-credit-calculator-stage-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate:links": "tsx scripts/check-local-links.ts",
    "privacy:scan": "tsx scripts/privacy-scan.ts",
    "openspec:validate": "openspec validate --all --strict && openspec validate --archived --strict",
    "check": "npm run typecheck && npm test && npm run validate:links && npm run privacy:scan && npm run openspec:validate && npm run build"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
